{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "txt",
  "version": "0.2.0",
  "identifier": "com.cx.txt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5290",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash scripts/build-mcp.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["txt"] } },
    "updater": {
      "endpoints": ["https://github.com/cxrobx/txt/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNDY0OTkzQTg5RUJEQ0MKUldUTXZaNm9rMGxHTElxZFhZYlRiQ3VKbEhHTUFIU3dpS1BmU3M3UGhOa2kwWnBYQ09jUU5Kb3gK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "externalBin": ["binaries/txt-mcp"],
    "fileAssociations": [
      { "ext": ["txt", "md"], "name": "Note", "role": "Editor", "rank": "Alternate" }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
