{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "txt",
  "version": "0.1.0",
  "identifier": "com.cx.txt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5290",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash scripts/build-mcp.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["txt"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "externalBin": ["binaries/txt-mcp"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
